# Copy to .env for local development. Keep real credentials out of Git.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://support:local-development-only@db:5432/support
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Pin a model commit for reproducible runs, for example: EMBEDDING_MODEL_REVISION=<commit-sha>
EMBEDDING_MODEL_REVISION=
EMBEDDING_BATCH_SIZE=64
SEMANTIC_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=20
RRF_CONSTANT=60
# Comma-separated controlled complaint labels; keep `unknown` in each list.
COMPLAINT_INTENTS=connectivity_issue,esim_activation,payment_failed,duplicate_charge,billing_dispute,roaming_issue,account_access,security_concern,device_issue,general_inquiry,unknown
COMPLAINT_CATEGORIES=network,esim,sim,billing,payments,roaming,account,device,outage,general_inquiry,unknown
COMPLAINT_PRODUCTS=broadband,mobile_data,fifth_generation_mobile,esim,sim,voice,payments,roaming,account,device,unknown
KNOWLEDGE_SEMANTIC_CANDIDATE_LIMIT=20
KNOWLEDGE_LEXICAL_CANDIDATE_LIMIT=20
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
RESOLUTION_KNOWLEDGE_EVIDENCE_LIMIT=5
RESOLUTION_HISTORICAL_EVIDENCE_LIMIT=4
RESOLUTION_MIN_KNOWLEDGE_SIMILARITY=0.40
RESOLUTION_MIN_KNOWLEDGE_LEXICAL_SCORE=0.50
